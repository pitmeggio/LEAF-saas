// Academy SaaS — Academy Operating System + Athlete Performance Platform (MVP).
// Launch sport: alpine skiing (FIS). Schema kept generic for multi-sport + multi-tenant by academyId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Central tenant. Every academy-owned table carries academyId and is scoped by it
// (see src/lib/auth.ts). SUPER_ADMIN users bypass scoping via the /super-admin portal.
model Academy {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  country      String
  location     String? // city / region
  sport        String        @default("ski")
  season       String? // e.g. 2026/27
  tagline      String?
  description  String?
  requirements String? // newline-separated bullet points
  logoColor    String        @default("#7CFF6B")
  currency     String        @default("EUR") // academy's base/operating currency (ISO 4217) — drives display + finance aggregation
  status       String        @default("active") // active | inactive  (deactivated tenants are locked out)
  plan         String        @default("BASIC") // BASIC | PRO | ELITE  (subscription tier)
  // LEAF OS tier — drives which workspace tabs the academy can switch
  // between in the sidebar. "professional" = performance layer only (elite
  // academies). "essential" = ops layer only (booking-focused clubs).
  // "complete" = both (e.g. Trysil has elite team + Pay-and-Train).
  tier         String        @default("professional") // essential | professional | complete

  // ── Platform-controlled feature flags (set by super-admin per tenant) ──
  // Gate whole modules on/off independently of the academy's own settings.
  featureRecruiting     Boolean @default(true)
  // Public athlete profiles default OFF — the feature is meaningful once a
  // discovery / marketplace surface exists. Super admin can flip per-academy
  // for showcase / early-adopter tenants.
  featurePublicProfiles Boolean @default(false)
  featureFinance        Boolean @default(true)
  featureChat           Boolean @default(true)
  maxAthletes           Int?    // null = unlimited (plan default)
  requiredDocs          String? // comma-separated document keys; null = platform default
  // Config-driven application form. JSON shape: { fields: ApplicationFieldConfig[] }.
  // null = platform default form (see lib/applicationForm.ts). Additive + reversible:
  // standard answers still map to Application columns, custom answers to customFields.
  applicationConfig     Json?

  // ── External finance integration (read-only analytics over the academy's own
  // gestionale / billing software). LEAF does NOT issue invoices; it syncs invoice
  // + payment data from the provider and analyses it. See lib/finance/.
  // financeProvider: null = LEAF-managed (legacy/demo) | "mock" | "csv" | "stripe" | …
  financeProvider       String?
  financeConfig         Json?     // provider connection settings (non-secret pointers)
  financeSyncedAt       DateTime? // last successful sync

  // ── Public recruiting (surfaced by the profiles.leaf.ai experience) ──
  // Only exposed when recruitingEnabled && status == "active". Read exclusively
  // through src/lib/profiles.ts, which never returns private/financial fields.
  recruitingEnabled         Boolean  @default(false)
  recruitingStatus          String   @default("CLOSED") // OPEN | LIMITED_SPOTS | WAITLIST_OPEN | CLOSED
  publicRecruitingHeadline  String?
  publicRecruitingDescription String?
  applicationDeadline       DateTime?
  availableSpots            Int?
  acceptedCountries         String? // newline/comma-separated ISO codes or names
  ageCategories             String? // newline-separated (e.g. "U16", "U18", "U21")
  rankingRequirement        String?
  programTypes              String? // comma-separated: Full Package | Training Only | Race Support | Custom
  applicationUrl            String? // external apply URL — used instead of the internal /academy/[slug]/apply form when set
  featuredAcademy           Boolean  @default(false)
  contactEmail              String?
  publicApplyEnabled        Boolean  @default(true)

  programs     Program[]
  packages     Package[]
  applications Application[]
  opportunities Opportunity[]
  groups        Group[]
  coaches       Coach[]
  enrollments   Enrollment[]
  payments      Payment[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]
  expenses      Expense[]
  expenseReceipts ExpenseReceipt[]
  revenues      Revenue[]
  conversations Conversation[]
  users         User[]
  trainingSessions TrainingSession[]
  timingResults TimingResult[]
  contracts     Contract[]
  calendarEvents CalendarEvent[]
  coachNotes    CoachNote[]
  tennisMatches TennisMatch[]
  budgetBenchmarks AcademyBudgetBenchmarks?
  trainingSlopes TrainingSlope[]
  lineBookings  LineBooking[]
  // LEAF OS Tennis (Professional + Essential). All purely additive — the
  // ski side does not know these exist. Tennis-only academies (sport=tennis)
  // get the surfaces below; ski academies don't see them. Multi-sport
  // tenants get both, gated in the UI by sport on each entity.
  tennisFacilities TennisFacility[]
  tennisCourts     TennisCourt[]
  courtBookings    CourtBooking[]
  tennisCamps      TennisCamp[]
  tennisTournaments TennisTournament[]
  tennisSeasonPlans TennisSeasonPlan[]
  athleteFiles      AthleteFile[]
  essentialCheckouts EssentialCheckout[]
  wellnessCheckins  WellnessCheckin[]
  createdAt     DateTime       @default(now())
}

// LEAF OS Essential — Line booking & Pay-and-Train.
//
// Models the way an alpine race centre actually books training: each slope
// has multiple parallel "lines" (lanes carved for a discipline) that teams
// reserve in 2-hour blocks. Trysil's Treningsskjema.xlsx maps 1:1 here:
// Slope 63 has 5 lines, Slope 80 has 3, slots run from 08:00 to 20:00.
//
// Any LineBooking with payAndTrainEnabled=true on its slot exposes that
// time to the public Pay-and-Train widget: an outside skier can book the
// empty lane online and the academy monetises slots that would otherwise
// sit idle. Internal team bookings (groupId set) never appear on the
// public widget.
model TrainingSlope {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String                // "Slope 63", "Slope 80"
  facility    String?               // "Trysil Race Center Høgegga"
  notes       String?
  active      Boolean  @default(true)
  lines       TrainingLine[]
  createdAt   DateTime @default(now())
}

model TrainingLine {
  id          String   @id @default(cuid())
  slopeId     String
  slope       TrainingSlope @relation(fields: [slopeId], references: [id], onDelete: Cascade)
  label       String                // "L1", "L2" or "1", "2"
  position    Int                   // ordering within the slope (1..N)
  bookings    LineBooking[]
}

model LineBooking {
  id           String   @id @default(cuid())
  academyId    String
  academy      Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  lineId       String
  line         TrainingLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  // Either an internal team reservation OR a public Pay-and-Train booking.
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id])
  startAt      DateTime
  endAt        DateTime
  label        String?               // short code shown in cell: "TRA", "DEV GS", "TECH SL"
  discipline   String?               // SL | GS | SG | DH | Speed
  notes        String?
  // Public booking fields — populated for both Pay-and-Train customers
  // (parents booking Jonas's sessions on pre-listed slots) and external
  // club coaches (self-service booking of a free training line).
  //
  //   • payAndTrainEnabled=true                       → P&T slot (Jonas)
  //   • bookerOrg!=null + customerEmail!=null          → external club
  //   • groupId!=null                                  → internal team
  payAndTrainEnabled Boolean @default(false)  // slot is offered publicly as Pay-and-Train
  publicPrice  Int?                            // price per slot in academy currency major units
  customerName  String?
  customerEmail String?
  customerPhone String?
  bookerOrg     String?                        // club / organization name (external-coach bookings)
  status       String   @default("confirmed")  // confirmed | pending | cancelled
  paidAmount   Int      @default(0)
  stripePaymentId String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([academyId, startAt])
  @@index([lineId, startAt])
}

// Per-academy cost benchmarks the budget forecast engine multiplies by
// quantities derived from the roster / season calendar / coach roster.
// Set ONCE per academy (admin form); the engine reads them on every
// `computeGroupBudgetForecast()` call and surfaces a per-group forecast
// alongside actual spend. Values are stored in currency major units
// (e.g. NOK 1000, not øre) and always interpreted in Academy.currency.
// Adding a sport-specific rate? Keep the field name generic so other
// sports (tennis camps, padel travel) can reuse it.
model AcademyBudgetBenchmarks {
  id        String  @id @default(cuid())
  academyId String  @unique
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  // ── Lodging / travel rates ──
  pricePerNight              Int @default(0)  // hotel / lodge per athlete per night on the road
  liftPassPerDay             Int @default(0)  // per athlete per training/race day on snow
  mealsPerDay                Int @default(0)  // per athlete per day while travelling
  fuelPerTravelDay           Int @default(0)  // per van / per travel day
  vanCostAnnual              Int @default(0)  // insurance + depreciation + service per academy / year
  housingMonthly             Int @default(0)  // long-stay apartment per athlete / month (base camp)
  housingMonthsPerSeason     Int @default(8)  // how many months the base-camp apartment runs
  clothingPerAthlete         Int @default(0)  // team kit / season / athlete

  // ── Staff rates ──
  headCoachMonthlyRate       Int @default(0)
  headCoachMonthsPerSeason   Int @default(12)
  assistantCoachMonthlyRate  Int @default(0)
  assistantCoachMonthsPerSeason Int @default(8)

  // ── Academy-wide overheads (allocated per group by share-of-athletes) ──
  miscAnnual                 Int @default(0)  // catch-all (admin, comms, etc.)
  sportOpsAnnual             Int @default(0)  // race entries, federation fees, equipment, …

  // ── Calendar fallbacks ──
  // Used when the season calendar (CalendarEvent) is empty so the page
  // still produces a sensible forecast on day 1. Once the calendar is
  // populated the engine prefers the real event totals.
  defaultTravelDaysPerSeason Int @default(0)
  defaultRaceDaysPerSeason   Int @default(0)
  defaultNightsPerSeason     Int @default(0)

  updatedAt DateTime @updatedAt
}

// Academy-wide calendar (summer / autumn / winter / spring programmes).
// Academy admin can manage any event; coaches manage events for their own groups;
// athletes see events for the groups they are enrolled in (+ academy-wide).
model CalendarEvent {
  id          String    @id @default(cuid())
  academyId   String
  academy     Academy   @relation(fields: [academyId], references: [id])
  groupId     String?   // null = academy-wide event
  group       Group?    @relation(fields: [groupId], references: [id])
  coachId     String?
  coach       Coach?    @relation(fields: [coachId], references: [id])
  title       String
  type        String    @default("training") // training | camp | race | travel | meeting | off | other
  season      String    @default("all") // summer | autumn | winter | spring | all
  startDate   DateTime
  endDate     DateTime?
  location    String?       // Plan A — primary location (e.g. "Saas-Fee", "Hintertux")
  planBLocation String?     // Plan B — alternative location
  discipline  String?       // SL | GS | SG | DH | Speed block | …
  notes       String?
  coachesNote String?       // free text for assigned coaches (Excel "Trenere" column)
  currency    String    @default("EUR")
  // Cost breakdown — coach inputs these; estimatedCost / actualCost are headline totals.
  costHotel       Int @default(0)
  costFlights     Int @default(0)
  costVan         Int @default(0)
  costFuel        Int @default(0)
  costLiftPass    Int @default(0)
  costCoach       Int @default(0)
  costAccommodation Int @default(0)
  costRaceFees    Int @default(0)
  costMisc        Int @default(0)
  estimatedCost   Int?      // override; else sum of breakdown
  actualCost      Int?      // what was actually spent
  createdById String?
  createdBy   User?     @relation("CalendarCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([academyId, startDate])
}

// A training session for a group on a date. Attendance is recorded per athlete.
model TrainingSession {
  id         String       @id @default(cuid())
  academyId  String
  academy    Academy      @relation(fields: [academyId], references: [id])
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id])
  date       DateTime
  title      String?
  coachId    String?
  coach      Coach?       @relation(fields: [coachId], references: [id])
  notes      String?
  attendance Attendance[]
  createdAt  DateTime     @default(now())
}

// Athlete contract tied to an enrollment. Status flows draft → sent → signed,
// with optional term dates + value (feeds contract reminders + finance later).
model Contract {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  status       String     @default("draft") // draft | sent | signed | expired
  startDate    DateTime?
  endDate      DateTime?
  value        Int? // contract value (currency major units)
  currency     String     @default("EUR")
  fileUrl      String?
  notes        String?
  signedAt     DateTime?
  createdAt    DateTime   @default(now())
}

model Attendance {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       String          @default("present") // present | late | absent | excused | injured
  note         String?
  createdAt    DateTime        @default(now())

  @@unique([sessionId, enrollmentId])
}

// Inbound academy onboarding requests (apply / request a demo). Reviewed in the
// super-admin portal; approval provisions a tenant + owner account.
model AcademyRequest {
  id          String   @id @default(cuid())
  academyName String
  contactName String
  email       String
  phone       String?
  country     String
  location    String?
  sport       String   @default("ski")
  plan        String   @default("BASIC") // requested tier
  message     String?
  status      String   @default("pending") // pending | approved | rejected
  reviewerNote String?
  provisionedAcademyId String? // set when approved → created Academy id
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  passwordHash String? // bcrypt hash; null = no credential set yet (legacy/demo)
  role      String   @default("coach") // super_admin | academy_admin | coach | athlete | recruiter
  academyId String? // null for super_admin (platform-level, not bound to a tenant)
  academy   Academy? @relation(fields: [academyId], references: [id])
  coachId   String? // links a coach login to their Coach record (scopes their workspace)
  coach     Coach?   @relation(fields: [coachId], references: [id])
  athleteId String? // links an athlete login to their Athlete record (My Profile workspace)
  athlete   Athlete? @relation(fields: [athleteId], references: [id])
  notes     Note[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  approvedExpenses Expense[] @relation("ExpenseApprover")
  expenseEvents ExpenseEvent[]
  createdCalendarEvents CalendarEvent[] @relation("CalendarCreator")
  authoredCoachNotes CoachNote[] @relation("CoachNoteAuthor")
  authoredAthleteFiles AthleteFile[] @relation("AthleteFileAuthor")
  createdAt DateTime @default(now())
}

model Coach {
  id             String       @id @default(cuid())
  academyId      String
  academy        Academy      @relation(fields: [academyId], references: [id])
  name           String
  email          String?
  phone          String?
  role           String       @default("coach") // head_coach | coach | physio | s_and_c
  specialization String? // slalom, speed, fitness…
  cost           Int? // season cost / salary (currency major units) — used for group margin
  notes          String?
  active         Boolean      @default(true)
  groups         Group[]
  enrollments    Enrollment[]
  users          User[]
  expenses       Expense[]
  sessions       TrainingSession[]
  calendarEvents CalendarEvent[]
  coachNotes     CoachNote[]
  // Living "coaching style" — themeFrequency + recurring focus areas
  // aggregated across every note this coach writes. The structurer feeds
  // this back into the LLM prompt so analyses become personalised over
  // time (Coach A → technical-heavy, Coach B → tactical-heavy, …).
  aiStyle        Json?
  aiStyleUpdatedAt DateTime?
  createdAt      DateTime     @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  coachId     String? // null = entered directly by the academy admin (a group budget line)
  coach       Coach?   @relation(fields: [coachId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  title       String
  amount      Int
  currency    String   @default("EUR")
  category    String   @default("other") // hotel | fuel | lift_pass | transport | equipment | race_cost | other (legacy: travel | accommodation)
  status      String   @default("draft") // draft | submitted (pending) | approved | rejected | reimbursed
  notes       String?
  expenseDate DateTime? // when the cost was incurred (defaults to createdAt if unset)
  receiptUrl  String? // link to the uploaded receipt
  // ── Accounting layer (PowerOffice replacement) ──
  // amount is the GROSS (VAT-inclusive) cost in major units. net/VAT are derived
  // from vatRate at read/export time (see lib/accounting.splitVat).
  kind          String  @default("expense") // expense | mileage
  supplier      String? // leverandør / vendor name
  accountCode   String? // kontonummer (chart-of-accounts code)
  vatRate       Int? // MVA / IVA percent: 25 | 15 | 12 | 0 | 22 | 10 | 4
  paymentMethod String? // private_outlay | company_card | cash | bank_transfer
  // Mileage (kjøregodtgjørelse) — set when kind = "mileage". amount is computed
  // server-side as round(distanceKm × ratePerKmCents / 100).
  distanceKm     Int?
  ratePerKmCents Int? // rate per km in minor units (350 = 3.50 / km)
  fromPlace      String?
  toPlace        String?
  approvedById String? // user (academy admin) who approved/rejected
  approvedBy   User?    @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  events      ExpenseEvent[]
  receipts    ExpenseReceipt[]
  createdAt   DateTime @default(now())
}

// Receipt photo(s) attached to an expense — the PowerOffice "kvittering / bilag"
// flow. Coaches snap a photo of the receipt (or upload a PDF) and the bytes live
// in Postgres (bytea) so it works on any deploy with zero extra infra. An
// expense can carry several receipts; admins view them in the approval queue.
model ExpenseReceipt {
  id             String   @id @default(cuid())
  academyId      String
  academy        Academy  @relation(fields: [academyId], references: [id])
  expenseId      String
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName       String
  fileMime       String // image/jpeg | image/png | image/webp | image/heic | application/pdf
  fileSize       Int
  fileData       Bytes
  uploadedById   String? // user who uploaded (coach or admin)
  uploadedByName String? // denormalised — survives user deletion
  createdAt      DateTime @default(now())

  @@index([academyId, expenseId])
}

// Income — non-Payment revenue streams that feed a team's budget.
// Athlete fees flow through Payment (per-enrollment). Everything else — sponsor
// deals, federation grants, academy allocations — lives here so the Budget
// Tracker can show a real net result (income − expense) per team.
// Manual entry today; future integrations (Stripe, bank import) drop in here.
model Revenue {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  title       String
  amount      Int      // currency major units (e.g. EUR)
  currency    String   @default("EUR")
  // athlete_fee  = aggregated/individual fee outside the Payment flow
  // sponsor      = sponsor contribution
  // federation   = federation grant / contribution
  // academy_allocation = budget allocated from the academy's general pot
  // other        = misc
  category    String   @default("other")
  // received   = cash in the bank already
  // pledged    = promised, not yet received (counts as forecast)
  // cancelled  = killed
  status      String   @default("received")
  receivedDate DateTime?
  notes       String?
  source      String?  // free text: sponsor name, federation name, etc.
  createdAt   DateTime @default(now())

  @@index([academyId, groupId])
}

// Immutable audit trail for an expense — every status change / edit, with who + when.
model ExpenseEvent {
  id         String   @id @default(cuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  type       String // created | submitted | approved | rejected | reimbursed | edited
  fromStatus String?
  toStatus   String?
  byUserId   String?
  byUser     User?    @relation(fields: [byUserId], references: [id])
  byName     String? // denormalised actor name (survives user deletion)
  note       String?
  createdAt  DateTime @default(now())
}

model Program {
  id           String        @id @default(cuid())
  academyId    String
  academy      Academy       @relation(fields: [academyId], references: [id])
  name         String
  discipline   String
  ageMin       Int
  ageMax       Int
  season       String
  applications Application[]
}

model Package {
  id            String        @id @default(cuid())
  academyId     String
  academy       Academy       @relation(fields: [academyId], references: [id])
  name          String
  description   String?
  price         Int? // in currency major units
  currency      String        @default("EUR")
  period        String        @default("season") // season | camp | month
  billingFreq   String        @default("seasonal") // one_time | monthly | seasonal
  features      String? // newline-separated
  accommodation Boolean       @default(false)
  transport     Boolean       @default(false)
  coaching      Boolean       @default(true)
  raceSupport   Boolean       @default(false)
  maxAthletes   Int?
  active        Boolean       @default(true)
  notes         String?
  order         Int           @default(0)
  applications  Application[]
  enrollments   Enrollment[]
}

model Athlete {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  dob             DateTime
  nationality     String
  gender          String?
  sport           String         @default("ski")
  discipline      String
  email           String?
  phone           String?
  address         String?
  emergencyContact String?
  guardianName    String?
  guardianContact String?
  fisCode         String?        @unique
  fisPoints       Float?
  worldRank       Int?
  injuryFlag      Boolean        @default(false)
  photoColor      String         @default("#1f2937")
  bio             String?
  location        String?
  verified        Boolean        @default(true)

  // ── Public recruiting profile (read by the profiles.leaf.ai experience) ──
  // All public visibility is opt-in and per-field. The public read layer
  // (src/lib/profiles.ts) is the ONLY place these are exposed, and it never
  // returns the private columns above (notes, injuryFlag, contacts, etc.).
  publicProfileEnabled      Boolean  @default(false)
  publicSlug                String?  @unique
  publicVisibility          String   @default("PRIVATE") // PUBLIC | PRIVATE | INVITE_ONLY | ACADEMY_ONLY
  publicBio                 String?
  publicPhotoUrl            String?
  publicShowAcademy         Boolean  @default(true)
  publicShowRanking         Boolean  @default(true)
  publicShowResults         Boolean  @default(true)
  publicShowMedia           Boolean  @default(true)
  publicShowExternalProfiles Boolean @default(true)
  publicContactEnabled      Boolean  @default(false)
  publicVerified            Boolean  @default(false)
  fisProfileUrl             String?
  atpPlayerId               String?
  atpProfileUrl             String?
  // Tennis ranking lookup codes — the "athlete code" the import-by-code flow
  // resolves against. ATP/WTA reuse atpPlayerId above; these add the two that
  // matter for an Italian junior academy.
  itfJuniorRef              String?  // ITF Junior IPIN / player reference
  fitTessera                String?  // Federazione Italiana Tennis tessera number
  codiceFiscale             String?  // Italian fiscal code (anagrafica)
  // Federation membership expiry dates → drive the anagrafica scadenza alerts.
  fitTesseraExpiry          DateTime? // tessera FIT renewal deadline
  ipinExpiry                DateTime? // ITF iPin expiry

  rankings        RankingPoint[]
  tennisRankings  TennisRankingSnapshot[]
  fisSnapshots    FisListSnapshot[]
  results         Result[]
  timingResults   TimingResult[]
  media           Media[]
  publicMedia     PublicAthleteMedia[]
  applications    Application[]
  enrollments     Enrollment[]
  conversations   Conversation[]
  users           User[]
  coachNotes      CoachNote[]
  athleteFiles    AthleteFile[]
  wellnessCheckins WellnessCheckin[]

  // Living athlete profile maintained by the Coach Intelligence engine.
  // Shape is intentionally Json — the structurer evolves per sport, so the
  // schema must not lock the dimensions in concrete. See lib/ai/coachProfile.ts
  // for the canonical AthleteAiProfile type.
  aiProfile       Json?
  aiProfileUpdatedAt DateTime?

  // ── Tennis (and other coach-driven sports) profile fields ──
  // Ski uses FIS code / points / world rank (above). Tennis is development-
  // based, so it carries coach-curated dimensions instead. All optional and
  // sport-agnostic at the column level — the UI shows them only when
  // athlete.sport === "tennis" (or whichever sports we add later).
  dominantHand    String?        // right | left | ambidextrous
  playingStyle    String?        // free text: "aggressive baseliner", "all-court", …
  // 1..10 self/coach-rated levels — feed the future tennis dashboards.
  technicalLevel  Int?
  tacticalLevel   Int?
  physicalLevel   Int?
  mentalLevel     Int?
  developmentGoals String?       // free text, multiline

  // Season-level intent set by the athlete (or coach) — surfaced on /me
  // and on the admin detail page. Free text, multiline. Drives no logic
  // today; AI Coach Notes may align suggestions against it in the future.
  seasonGoals     String?

  tennisMatches   TennisMatch[]
  // Tennis season plans (LEAF OS Professional Tennis) — Max's Excel
  // becomes one row per athlete, hosting tournament entries by week.
  tennisSeasonPlans TennisSeasonPlan[]

  // Universal Athlete Performance Layer — 1:1 sport-specific extension
  // tables. New writes target these; old reads still hit the legacy columns
  // above as fallback (see lib/athleteProfile.ts).
  skiProfile      SkiProfile?
  tennisProfileExt TennisProfile?

  createdAt       DateTime       @default(now())
}

// Curated public portfolio assets, separate from internal `Media`. Only rows with
// isApprovedPublic = true are ever surfaced on the public profile.
model PublicAthleteMedia {
  id            String   @id @default(cuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  type          String // IMAGE | VIDEO | PDF | LINK
  title         String
  url           String
  thumbnailUrl  String?
  isApprovedPublic Boolean @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Historical FIS points snapshots — the source of the growth trend.
model RankingPoint {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime
  fisPoints Float
  worldRank Int?
}

// Per-discipline FIS points snapshot, captured from a specific official FIS
// points list (fis-ski.com publishes ~22 lists per season). Each (athlete,
// list, discipline) tuple is unique. Stored once per sync — the live FIS
// provider walks the most recent N lists and upserts the rows it finds.
//
// Powers the per-discipline trend on the athlete page (lib/ai/pointsTrend.ts)
// without ever fabricating data: a discipline with one snapshot reads as
// "insufficient_data", two or more drive an improving/declining trend.
model FisListSnapshot {
  id          String   @id @default(cuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  listid      Int      // FIS source list id (e.g. 452 → "22nd FIS points list 2025/26")
  publishedAt DateTime // list valid-from date — what the trend chart plots against
  discipline  String   // slalom | giant_slalom | super_g | downhill
  fisPoints   Float
  worldRank   Int?
  syncedAt    DateTime @default(now())

  @@unique([athleteId, listid, discipline])
  @@index([athleteId, discipline, publishedAt])
}

model Result {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  date       DateTime
  eventName  String
  location   String
  discipline String
  rank       Int // finishing place (ignored when status != finished)
  fisPoints  Float
  status     String   @default("finished") // finished | dnf | dns | dsq — powers DNF% analytics
}

// LEAF — Staff Dossier. The per-athlete shared file hub: every staff member
// (maestro, preparatore atletico, mental, fisio, admin) drops the files they
// already use — match reports, fitness sheets, their OWN evaluation grids,
// scouting PDFs — onto one athlete, so nobody hunts through scattered files
// and everyone reads the same performance story.
//
// Storage: file bytes live in Postgres (bytea, like Document) so upload works
// with zero extra infra; a paste-link (Drive/YouTube) is the no-binary
// alternative. An optional `score` turns a row into a tracked evaluation —
// the dossier draws the performance trend from those over `observedAt`.
model AthleteFile {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  // Authorship — who on staff contributed it.
  authorId    String?
  author      User?    @relation("AthleteFileAuthor", fields: [authorId], references: [id])
  authorName  String   // denormalized display name (survives author deletion)
  authorRole  String?  // free label: "Maestro", "Preparatore atletico", "Mental", "Fisio"
  // What kind of contribution.
  category    String   @default("file") // evaluation | match_report | physical | medical | video | scouting | file
  // Anagrafica document typing + expiry (tessera FIT, iPin, certificato medico,
  // passaporto, carta d'identità). expiresAt drives the scadenza alerts.
  docType     String?  // tessera_fitp | ipin | medical | passport | id_card | insurance | other
  expiresAt   DateTime?
  title       String
  note        String?  // free comment so staff communicate ("rovescio in palla alta da migliorare")
  // Optional headline score → builds the performance trend. scoreScale = the
  // max (e.g. 10 or 100) so different staff scales render consistently.
  score       Float?
  scoreScale  Int?
  observedAt  DateTime // the date the observation/evaluation refers to (trend x-axis)
  // In-Postgres file (bytea) OR a pasted external link — either/both optional.
  fileName    String?
  fileMime    String?
  fileSize    Int?
  fileData    Bytes?
  fileUrl     String?
  createdAt   DateTime @default(now())

  @@index([academyId, athleteId, observedAt])
}

// LEAF OS Essential — online payment for a payable item (camp registration or
// court booking). One row per checkout attempt. Stripe hosts the payment page
// (Apple Pay / Google Pay / cards appear automatically); the webhook flips
// status to "paid" and stamps the source item's paidAmount. "manual" = the
// admin marked it collected offline (cash/bank) without a gateway.
// LEAF — Athlete Management System (AMS). The daily wellness/readiness check-in
// the athlete does on the app in ~20 seconds. Teamworks/Smartabase's flagship,
// reduced to one delightful screen. Metrics are 1–5 self-ratings; `readiness`
// (0–100) is derived so staff can triage the squad at a glance. One row per
// athlete per day.
model WellnessCheckin {
  id           String   @id @default(cuid())
  academyId    String
  academy      Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date         DateTime // UTC midnight of the check-in day
  sleepHours   Float?   // hours slept last night
  sleepQuality Int      // 1 (terrible) – 5 (great)
  soreness     Int      // 1 (fresh) – 5 (very sore)   — higher is worse
  energy       Int      // 1 (empty) – 5 (full)
  mood         Int      // 1 (low) – 5 (great)
  stress       Int      // 1 (calm) – 5 (very stressed) — higher is worse
  readiness    Int      // 0–100 derived score
  note         String?
  createdAt    DateTime @default(now())

  @@unique([athleteId, date])
  @@index([academyId, date])
}

model EssentialCheckout {
  id              String   @id @default(cuid())
  academyId       String
  academy         Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  kind            String   // camp_reg | court_booking
  refId           String   // TennisCampRegistration.id | CourtBooking.id
  amount          Int      // major units (EUR)
  currency        String   @default("EUR")
  description     String
  customerEmail   String?
  customerName    String?
  status          String   @default("pending") // pending | paid | canceled | manual
  provider        String   @default("stripe")
  stripeSessionId String?  @unique
  url             String?  // Stripe-hosted checkout URL
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([academyId, kind, refId])
}

// Tennis ranking observation — one row per (athlete, source, date). The
// tennis analogue of FisListSnapshot. Sources are heterogeneous on purpose:
//   • FIT  → Italian federation: a *classifica* string ("2.6", "3.1", "4.NC")
//            plus an optional national position, NOT a simple world rank.
//   • ITF  → ITF Junior world rank + points.
//   • ATP/WTA → pro world rank + points.
// Stored as nullable columns so each source fills only what it has. Two or
// more snapshots for a source drive the ranking trajectory on the canvas.
model TennisRankingSnapshot {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source     String   // FIT | ITF | ATP | WTA
  date       DateTime // observation / valid-from date — the trend x-axis
  rank       Int?     // world/national numeric position (ITF/ATP/WTA)
  points     Int?     // ranking points
  classifica String?  // FIT classifica, e.g. "2.6"
  category   String?  // free label, e.g. "Singolare", "U16", "Junior"
  origin     String   @default("manual") // manual | import:<provider>
  syncedAt   DateTime @default(now())

  @@index([athleteId, source, date])
}

model TimingResult {
  id         String   @id @default(cuid())
  academyId  String
  academy    Academy  @relation(fields: [academyId], references: [id])
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  batchId      String // the session this run belongs to (one imported file)
  date         DateTime
  kind         String   @default("training") // training | race
  discipline   String? // Event — GS / SL / SG / DH
  location     String? // Hill / venue
  sessionLabel String? // e.g. "Session #202 · 2026-2027 Training"
  bib          String?
  runNumber    Int? // which run in the session (1, 2, 3 …)
  finishMs     Int? // run finish time, milliseconds
  splitsMs     Int[] // cumulative intermediate split times (ms), variable length
  status       String? // "" | DNF | DNS | DSQ
  source       String   @default("import") // splitsecond | brower | microgate | alge | csv
  createdAt    DateTime @default(now())

  @@index([academyId, batchId])
  @@index([athleteId, date])
}

model Media {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])
  type      String
  title     String
  duration  String?
}

model Application {
  id             String        @id @default(cuid())
  academyId      String
  academy        Academy       @relation(fields: [academyId], references: [id])
  athleteId      String
  athlete        Athlete       @relation(fields: [athleteId], references: [id])
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  status         String        @default("new") // new | reviewing | shortlisted | accepted | rejected
  score          Int?
  source         String        @default("public_form")
  message        String?
  sport          String?
  currentRanking String?
  previousClub   String?
  guardianName   String?
  guardianContact String?
  mediaLink      String?
  customFields   Json? // academy-defined custom question answers ({ [fieldKey]: value })
  suggestedGroupId String? // auto-placement computed on arrival (Smart Group Assignment); overridable
  submittedAt    DateTime      @default(now())
  notes          Note[]
  events         StatusEvent[]
  enrollment     Enrollment?
  conversation   Conversation?
}

// A publishable recruiting opening (program / team position / camp / package).
// The dashboard creates these; the public academy site lists the published ones;
// applications can reference the opportunity they came from.
model Opportunity {
  id                  String        @id @default(cuid())
  academyId           String
  academy             Academy       @relation(fields: [academyId], references: [id])
  title               String
  type                String        @default("program") // program | position | camp | package
  season              String?
  ageGroup            String? // e.g. "U16-U18"
  discipline          String? // SL | GS | SG | DH | XC | ...
  packageType         String? // free-text package/tier label
  price               Int? // currency major units
  currency            String        @default("EUR")
  pricePublic         Boolean       @default(false) // show price publicly?
  applicationDeadline DateTime?
  spotsAvailable      Int?
  description         String?
  status              String        @default("draft") // draft | published | closed
  applications        Application[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// Active Athlete = an athlete enrolled at an academy. Multi-tenant by academyId.
model Enrollment {
  id            String            @id @default(cuid())
  academyId     String
  academy       Academy           @relation(fields: [academyId], references: [id])
  athleteId     String
  athlete       Athlete           @relation(fields: [athleteId], references: [id])
  status        String            @default("active") // active | paused | injured | completed | inactive
  level         String? // development | competitive | elite
  joinDate      DateTime          @default(now())
  coachId       String?
  coach         Coach?            @relation(fields: [coachId], references: [id])
  groupId       String?
  group         Group?            @relation(fields: [groupId], references: [id])
  packageId     String?
  package       Package?          @relation(fields: [packageId], references: [id])
  applicationId String?           @unique
  application   Application?      @relation(fields: [applicationId], references: [id])
  externalCustomerId String?      // maps this enrollment to a customer in the academy's finance system
  notes         String?
  payments      Payment[]
  documents     Document[]
  invoices      Invoice[]
  events        EnrollmentEvent[]
  conversations Conversation[]
  attendance    Attendance[]
  contracts     Contract[]
  createdAt     DateTime          @default(now())
}

model EnrollmentEvent {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  type         String // status | created | payment | document
  from         String?
  to           String?
  detail       String?
  createdAt    DateTime   @default(now())
}

model Payment {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  label        String? // e.g. "Installment 1/3"
  amount       Int
  paidAmount   Int        @default(0) // amount collected so far (for partial payments)
  currency     String     @default("EUR")
  dueDate      DateTime
  paidDate     DateTime?
  status       String     @default("unpaid") // unpaid | paid | partial  (overdue is derived from dueDate)
  method       String? // bank_transfer | card | cash
  notes        String?
  source       String     @default("leaf") // leaf | external  (external = synced from a finance provider, read-only)
  externalId   String? // id of the source record in the external finance system
  invoice      Invoice?
  createdAt    DateTime   @default(now())

  @@index([academyId, externalId])
}

model Document {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  type         String // medical_certificate | liability_waiver | academy_contract | race_license | travel | parent_approval | internal
  name         String?
  status       String     @default("missing") // missing | uploaded | verified | expired
  fileUrl      String? // external reference (Drive/Dropbox/ERP) — legacy/optional
  // In-app file storage ("App Documents"). Bytes live in Postgres (bytea) so
  // upload works on any deploy with zero extra infra/tokens. Swap to an object
  // store later behind the same upload/download route handlers.
  fileName     String?
  fileMime     String? // application/pdf | msword | spreadsheetml | …
  fileSize     Int? // bytes
  fileData     Bytes?
  uploadedAt   DateTime?
  required     Boolean    @default(true)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  authorId      String?
  author        User?       @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model StatusEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  from          String?
  to            String
  createdAt     DateTime    @default(now())
}

model Group {
  id          String       @id @default(cuid())
  academyId   String
  academy     Academy      @relation(fields: [academyId], references: [id])
  name        String
  sport       String       @default("ski")
  season      String
  coachId     String?
  coach       Coach?       @relation(fields: [coachId], references: [id])
  capacity    Int          @default(12)
  budget      Int? // allocated season budget (currency major units)
  budgetHardStop Boolean   @default(false) // block approvals that would exceed the budget
  active      Boolean      @default(true)
  notes       String?
  // ── Smart Group Assignment rules (per-academy config) ──
  // Null = no constraint. Points band is in the sport's native scale (e.g. FIS
  // points). The recommender scores applicants against these bands.
  pointsMin   Int? // lower bound of the group's ranking-points band
  pointsMax   Int? // upper bound
  ageMin      Int?
  ageMax      Int?
  level       String? // development | competitive | elite (target level)
  discipline  String? // optional discipline filter (null = any)
  enrollments   Enrollment[]
  expenses      Expense[]
  revenues      Revenue[]
  conversations Conversation[]
  sessions      TrainingSession[]
  calendarEvents CalendarEvent[]
  lineBookings  LineBooking[]
  courtBookings CourtBooking[]
  createdAt     DateTime     @default(now())
}

model Invoice {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  paymentId    String?    @unique
  payment      Payment?   @relation(fields: [paymentId], references: [id])
  number       String
  amount       Int
  currency     String     @default("EUR")
  status       String     @default("pending") // pending | sent | partial | paid | cancelled  (overdue derived from due date)
  issuedAt     DateTime   @default(now())
  dueDate      DateTime? // due date (external invoices carry their own; LEAF ones derive it from the payment)
  paidAt       DateTime?
  source       String     @default("leaf") // leaf | external
  externalId   String? // id of the source record in the external finance system

  @@index([academyId, externalId])
}

model Notification {
  id            String   @id @default(cuid())
  academyId     String
  academy       Academy  @relation(fields: [academyId], references: [id])
  type          String // thanks_for_applying | application_accepted | application_rejected | missing_documents | payment_reminder | payment_confirmation | invoice_available | enrollment_confirmed
  toEmail       String?
  toName        String?
  subject       String
  body          String
  status        String   @default("sent") // queued | sent
  applicationId String?
  enrollmentId  String?
  createdAt     DateTime @default(now())
}

// Internal communication layer. A thread is created with the application and follows
// the athlete through enrollment (history preserved).
model Conversation {
  id                   String       @id @default(cuid())
  academyId            String
  academy              Academy      @relation(fields: [academyId], references: [id])
  type                 String       @default("application") // application | athlete | group
  applicationId        String?      @unique
  application          Application? @relation(fields: [applicationId], references: [id])
  enrollmentId         String?
  enrollment           Enrollment?  @relation(fields: [enrollmentId], references: [id])
  athleteId            String?
  athlete              Athlete?     @relation(fields: [athleteId], references: [id])
  groupId              String?
  group                Group?       @relation(fields: [groupId], references: [id])
  subject              String?
  status               String       @default("open") // open | waiting | resolved
  assignedToUserId     String?
  assignedTo           User?        @relation("AssignedConversations", fields: [assignedToUserId], references: [id])
  lastMessageAt        DateTime     @default(now())
  lastMessagePreview   String?
  lastReadByStaffAt    DateTime?
  lastReadByExternalAt DateTime?
  // AI-ready (not used yet): summary, sentiment, risk flag
  summary              String?
  sentiment            String?
  riskFlag             Boolean      @default(false)
  messages             Message[]
  createdAt            DateTime     @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderSide     String // external | staff | system
  senderRole     String? // applicant | parent | athlete | coach | admin | system
  senderName     String?
  senderUserId   String?
  body           String
  createdAt      DateTime     @default(now())
}

// ── Coach Intelligence — Adaptive Coach Notes ─────────────────────────────
// The coach writes naturally (free text + optional file refs); the AI engine
// in lib/ai/coachNotes.ts reads it, detects the sport context (from the
// athlete's group), structures it dynamically, and merges insights into the
// athlete's living aiProfile. Raw text is preserved so the coach can always
// re-read what they actually wrote.
model CoachNote {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id])
  // Coach attribution — coachId for the academy-side coach record; authorId
  // ties back to the User who wrote it (admin can author notes too).
  coachId     String?
  coach       Coach?   @relation(fields: [coachId], references: [id])
  authorId    String?
  author      User?    @relation("CoachNoteAuthor", fields: [authorId], references: [id])

  // Original observation in the coach's own words. Never re-written by the AI.
  rawText     String
  // Sport snapshot at write time (taken from the athlete's group). Drives the
  // AI's analytic lens (ski technical/race; tennis match intelligence; ...).
  sport       String   @default("ski")
  // Optional coach-supplied kind hint. The structurer may refine / override.
  kind        String?  // training_session | race | match | video_review | physical_block | testing | other

  // Structured output of the AI — Json so dimensions can evolve per sport
  // without schema churn. Canonical shape in lib/ai/coachNotes.ts.
  aiSummary   Json?
  // Lifecycle of the structuring pass.
  status      String   @default("pending") // pending | structured | failed
  // Which engine produced aiSummary (llm | deterministic). Set by the worker.
  engine      String?
  error       String?

  attachments CoachNoteAttachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([academyId, athleteId, createdAt])
}

// Tennis (and other coach-driven sports) match record. Lightweight — opponent
// + date + result + score string + optional notes. Drives W/L stats on the
// athlete page; no ATP/WTA dependency by design.
model TennisMatch {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id])
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime
  opponent  String
  result    String   // won | lost
  score     String?  // e.g. "6-3 4-6 7-5"
  surface   String?  // hard | clay | grass | indoor
  notes     String?
  createdAt DateTime @default(now())

  @@index([academyId, athleteId, date])
}

// ── Universal Athlete Performance Layer ───────────────────────────────────
// Athlete stays the universal record (name, sport, contacts, …). Each sport
// owns a 1:1 profile table that holds its dimensions. This is the future-proof
// shape — for the MVP the legacy columns on Athlete (fisCode/fisPoints, the
// tennis levels) still drive the UI. The accessor lib/athleteProfile.ts
// reads either source (new table wins, falls back to the legacy columns),
// so call sites can migrate one at a time without breaking anything.
model SkiProfile {
  id         String   @id @default(cuid())
  athleteId  String   @unique
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  fisCode    String?  @unique
  fisPoints  Float?
  worldRank  Int?
  // Primary specialty (SL / GS / SG / DH / …). Athlete.discipline kept as
  // the legacy mirror; this one wins when populated.
  specialty  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TennisProfile {
  id               String   @id @default(cuid())
  athleteId        String   @unique
  athlete          Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  dominantHand     String?
  playingStyle     String?
  technicalLevel   Int?
  tacticalLevel    Int?
  physicalLevel    Int?
  mentalLevel      Int?
  developmentGoals String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Files attached to a note — PDF, Excel, scouting reports, etc. For the MVP
// we record metadata + a URL (paste-link or future Supabase Storage upload);
// no binary blob is held in Postgres.
model CoachNoteAttachment {
  id        String    @id @default(cuid())
  noteId    String
  note      CoachNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String    @default("application/octet-stream")
  size      Int       @default(0) // bytes; 0 = unknown (paste-link case)
  url       String
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAF OS Tennis — Professional + Essential primitives
//
// Mirrors the alpine architecture (Slope/Line/LineBooking) but tennis-shaped:
//   • TennisFacility   ←→ TrainingSlope     (the physical site, e.g. "Sede Padova")
//   • TennisCourt      ←→ TrainingLine      (a court inside the facility)
//   • CourtBooking     ←→ LineBooking       (time-block reservation)
// Two NEW concepts tennis needs that ski doesn't:
//   • TennisCamp / TennisCampRegistration   (summer camps + public sign-ups)
//   • TennisTournament + TennisSeasonPlan(Entry)
//                                           (Max's Excel — the coach's bible)
//
// Everything below is purely additive. Ski tenants never see these tables.
// ─────────────────────────────────────────────────────────────────────────────

model TennisFacility {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name      String   // "Sede Centrale Padova" / "Outdoor Estivo"
  address   String?
  notes     String?
  active    Boolean  @default(true)
  courts    TennisCourt[]
  createdAt DateTime @default(now())
}

model TennisCourt {
  id         String   @id @default(cuid())
  facilityId String
  facility   TennisFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  academyId  String
  academy    Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  label      String   // "Centrale" / "Court 1" / "Indoor 2"
  position   Int
  surface    String?  // clay | hard | carpet | grass | padel
  indoor     Boolean  @default(false)
  notes      String?
  bookings   CourtBooking[]
}

model CourtBooking {
  id           String   @id @default(cuid())
  academyId    String
  academy      Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courtId      String
  court        TennisCourt @relation(fields: [courtId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id])
  startAt      DateTime
  endAt        DateTime
  label        String?              // "U14" / "Agonistica" / "Lez. individuale"
  discipline   String?              // singles | doubles | lesson | sparring
  notes        String?
  publicBookingEnabled Boolean @default(false)
  publicPrice  Int?
  customerName String?
  customerEmail String?
  customerPhone String?
  bookerOrg    String?
  status       String   @default("confirmed")
  paidAmount   Int      @default(0)
  createdById  String?
  seriesId     String? // groups a weekly-recurring series so it can be edited/deleted together
  createdAt    DateTime @default(now())

  @@index([academyId, startAt])
  @@index([courtId, startAt])
  @@index([seriesId])
}

model TennisCamp {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String   // "Summer Camp Week 1" / "Mini-tennis U10"
  startDate   DateTime
  endDate     DateTime
  ageMin      Int?
  ageMax      Int?
  level       String?  // beginner | intermediate | competitive
  capacity    Int
  price       Int
  currency    String   @default("EUR")
  description String?
  coverImage  String?
  active      Boolean  @default(true)
  registrations TennisCampRegistration[]
  createdAt   DateTime @default(now())
}

model TennisCampRegistration {
  id          String   @id @default(cuid())
  campId      String
  camp        TennisCamp @relation(fields: [campId], references: [id], onDelete: Cascade)
  parentName  String
  parentEmail String
  parentPhone String?
  childName   String
  childDob    DateTime
  childLevel  String?
  notes       String?
  status      String   @default("pending") // pending | confirmed | cancelled | refunded
  paidAmount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([campId, status])
}

// Catalogue of tournaments the academy tracks. Coach adds once, every
// athlete's planner can pull from this catalogue. Imported in bulk from
// Max's "CALENDARI TORNEI" Excel.
model TennisTournament {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String   // "Open Ten Sport Center Cervia (RA)"
  category    String   // ITF | OPEN | RODEO | CAT_2 | CAT_3 | CAT_4 | TEAM | ETA | YOUTH | ALT
  location    String?
  startDate   DateTime
  endDate     DateTime
  ageGroup    String?  // U12 | U14 | U16 | U18 | OPEN | TEAM
  surface     String?  // clay | hard | grass | carpet
  pointsPotential Int? // ATP/ITF/FIT ranking points to winner
  drawSize    Int?     // 16 | 32 | 64
  externalUrl String?  // FIT iscrizioni link
  notes       String?
  createdAt   DateTime @default(now())

  entries     TennisSeasonPlanEntry[]

  @@index([academyId, startDate])
}

// Per-athlete season plan — Max's Excel page becomes a row.
model TennisSeasonPlan {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  season      String   // "2026" (tennis = calendar year, not split)
  // Per-athlete column schema — Max uses different categories per athlete
  // (ITF junior for elite, ETA U12 for kids). Stored as JSON so the
  // planner UI can drive its own columns without hardcoded enum.
  columns     Json     // e.g. ["ITF", "OPEN", "RODEO", "CAT_2", "CAT_3", "TEAM"]
  entries     TennisSeasonPlanEntry[]
  createdAt   DateTime @default(now())

  @@unique([athleteId, season])
}

model TennisSeasonPlanEntry {
  id            String  @id @default(cuid())
  planId        String
  plan          TennisSeasonPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Anchor on Monday of the planned week — week-level granularity matches
  // how Max plans (tournaments span a weekend, training fills the week).
  weekStart     DateTime
  // Training phase tag — drives the Season Arc color band + AI suggestions.
  // "Preparazione Invernale" | "TEST" | "Consolidamento" | "Mantenimento" | "Recovery"
  trainingPhase String?
  // Which column this entry sits in — must match plan.columns. Free-form
  // string so the academy can name categories however they like.
  columnKey     String
  // Optional FK into the tournament catalogue. NULL when coach typed
  // free-text (e.g. for a tentative entry).
  tournamentId  String?
  tournament    TennisTournament? @relation(fields: [tournamentId], references: [id])
  freeText      String?
  status        String  @default("planned") // planned | registered | confirmed | played | withdrawn
  resultRound   String?                     // SF | F | W | R32 | R16 | QF
  resultNotes   String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([planId, weekStart])
}

// Training / race programme the coach sends out (replaces Marius's WhatsApp
// Excel). The coach builds it in the OS for a group + date; on publish, the
// athletes in that group see it in the LEAF APP with a pop. The template has
// ~30 labelled rows that differ between training and race, so we store them as
// a key→value JSON (`fields`, driven by lib/trainingProgram.ts) plus the
// bib/goals lineup as JSON — no 60-column table. Scalar ids (no relations) to
// stay additive; group/coach names resolved on read.
model TrainingProgram {
  id          String    @id @default(cuid())
  academyId   String
  coachId     String? // who published it
  coachName   String? // denormalised — survives coach edits
  groupId     String? // target group → its enrolled athletes receive it
  kind        String    @default("training") // training | race
  title       String?
  place       String?
  discipline  String?
  date        DateTime // the day this programme is for
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  fields      Json      @default("{}") // template row key → value
  lineup      Json      @default("[]") // [{ bib, athleteId, name, goals }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([academyId, groupId, status])
}

// LEAF — Bacheca (Squad Board). Staff broadcast an announcement to the whole
// academy or a single group; athletes read it in the app and (optionally)
// acknowledge. Read/ack receipts give staff Teamworks' "seen by / confirmed
// by" visibility — the flagship engagement loop. Scalar ids (no relations to
// Academy/Athlete/User) to stay additive; names resolved on read.
model Announcement {
  id          String   @id @default(cuid())
  academyId   String
  authorId    String?
  authorName  String   // denormalized — survives author deletion
  authorRole  String?  // "Coach", "Direttore", "Segreteria"
  title       String
  body        String
  audience    String   @default("all") // all | group
  groupId     String?  // target group when audience = group
  pinned      Boolean  @default(false)
  requireAck  Boolean  @default(false) // athlete must tap "Confermo la lettura"
  createdAt   DateTime @default(now())

  receipts    AnnouncementReceipt[]

  @@index([academyId, createdAt])
}

// One row per (announcement, athlete) — created when the athlete opens the
// announcement (readAt) and stamped again if they acknowledge (ackedAt).
model AnnouncementReceipt {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  athleteId      String
  readAt         DateTime     @default(now())
  ackedAt        DateTime?

  @@unique([announcementId, athleteId])
  @@index([athleteId])
}

// LEAF — Event availability (RSVP). Athlete answers "ci sono / non ci sono /
// forse" for a CalendarEvent; staff sees the attendance forecast before the
// session. Scalar eventId (CalendarEvent.id, no relation) to stay additive.
model EventRsvp {
  id          String   @id @default(cuid())
  academyId   String
  eventId     String   // CalendarEvent.id
  athleteId   String
  status      String   @default("going") // going | not | maybe
  note        String?
  respondedAt DateTime @default(now())

  @@unique([eventId, athleteId])
  @@index([academyId, eventId])
}

// LEAF — Foglio ore & Stipendi. A coach submits the hours worked in a period
// (month), optionally attaching the source Excel; amount = hours × hourlyRate
// (auto, overridable). Admin/office review → approve → mark paid. Scalar ids
// (coachId, no relation) to stay additive; coachName denormalized on read.
model Timesheet {
  id          String   @id @default(cuid())
  academyId   String
  coachId     String   // Coach.id
  coachName   String   // denormalized display name
  period      String   // "2026-07" (month) or free label
  hours       Float    // total hours worked in the period
  hourlyRate  Int?     // €/h (major units) — coach's agreed rate
  amount      Int?     // computed pay (major units); null → hours × hourlyRate
  currency    String   @default("EUR")
  status      String   @default("submitted") // draft | submitted | approved | paid
  note        String?
  // Source Excel attachment (bytea in Postgres, like AthleteFile).
  fileName    String?
  fileMime    String?
  fileSize    Int?
  fileData    Bytes?
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?

  @@index([academyId, coachId, period])
}

// LEAF — Trasferte. A named away-trip (Kufstein, Riccione) that groups players
// for a tournament/block, INCLUDING players from other coaches or clubs not in
// the academy roster. Its point is splitting the shared costs among the people
// who went. Scalar academyId (no relation) to stay additive; members/expenses
// are new-model relations (cascade-deleted with the trip).
model Trip {
  id          String   @id @default(cuid())
  academyId   String
  name        String   // "Kufstein", "Riccione"
  location    String?
  zone        String?  // optional zone label (e.g. "Veneto", "Estero")
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  members     TripMember[]
  expenses    TripExpense[]

  @@index([academyId, startDate])
}

// A participant on the trip. In-roster athletes carry athleteId; external
// players (other coach / other club, "non in rosa") have athleteId = null and
// just a typed name + external flag.
model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  athleteId String?  // in-roster athlete, else null
  name      String   // display name (denormalized / free-text for externals)
  role      String   @default("player") // player | coach
  external  Boolean  @default(false)    // from another club / not in the rosters
  createdAt DateTime @default(now())

  @@index([tripId])
}

// A shared cost on the trip, split equally among the trip members. paidBy holds
// the member id who fronted it (for the settlement / "chi deve a chi").
model TripExpense {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label     String   // "Furgone", "Hotel", "Cena martedì"
  category  String   @default("other") // travel | hotel | meals | entry | misc
  amount    Int      // total cost (major units)
  currency  String   @default("EUR")
  date      DateTime?
  paidById  String?  // TripMember.id who paid it (null = academy/unassigned)
  createdAt DateTime @default(now())

  @@index([tripId])
}
