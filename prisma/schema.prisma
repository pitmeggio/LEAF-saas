// Academy SaaS — Academy Operating System + Athlete Performance Platform (MVP).
// Launch sport: alpine skiing (FIS). Schema kept generic for multi-sport + multi-tenant by academyId.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Central tenant. Every academy-owned table carries academyId and is scoped by it
// (see src/lib/auth.ts). SUPER_ADMIN users bypass scoping via the /super-admin portal.
model Academy {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  country      String
  location     String? // city / region
  sport        String        @default("ski")
  season       String? // e.g. 2026/27
  tagline      String?
  description  String?
  requirements String? // newline-separated bullet points
  logoColor    String        @default("#7CFF6B")
  currency     String        @default("EUR") // academy's base/operating currency (ISO 4217) — drives display + finance aggregation
  status       String        @default("active") // active | inactive  (deactivated tenants are locked out)
  plan         String        @default("BASIC") // BASIC | PRO | ELITE  (subscription tier)

  // ── Platform-controlled feature flags (set by super-admin per tenant) ──
  // Gate whole modules on/off independently of the academy's own settings.
  featureRecruiting     Boolean @default(true)
  // Public athlete profiles default OFF — the feature is meaningful once a
  // discovery / marketplace surface exists. Super admin can flip per-academy
  // for showcase / early-adopter tenants.
  featurePublicProfiles Boolean @default(false)
  featureFinance        Boolean @default(true)
  featureChat           Boolean @default(true)
  maxAthletes           Int?    // null = unlimited (plan default)
  requiredDocs          String? // comma-separated document keys; null = platform default
  // Config-driven application form. JSON shape: { fields: ApplicationFieldConfig[] }.
  // null = platform default form (see lib/applicationForm.ts). Additive + reversible:
  // standard answers still map to Application columns, custom answers to customFields.
  applicationConfig     Json?

  // ── External finance integration (read-only analytics over the academy's own
  // gestionale / billing software). LEAF does NOT issue invoices; it syncs invoice
  // + payment data from the provider and analyses it. See lib/finance/.
  // financeProvider: null = LEAF-managed (legacy/demo) | "mock" | "csv" | "stripe" | …
  financeProvider       String?
  financeConfig         Json?     // provider connection settings (non-secret pointers)
  financeSyncedAt       DateTime? // last successful sync

  // ── Public recruiting (surfaced by the profiles.leaf.ai experience) ──
  // Only exposed when recruitingEnabled && status == "active". Read exclusively
  // through src/lib/profiles.ts, which never returns private/financial fields.
  recruitingEnabled         Boolean  @default(false)
  recruitingStatus          String   @default("CLOSED") // OPEN | LIMITED_SPOTS | WAITLIST_OPEN | CLOSED
  publicRecruitingHeadline  String?
  publicRecruitingDescription String?
  applicationDeadline       DateTime?
  availableSpots            Int?
  acceptedCountries         String? // newline/comma-separated ISO codes or names
  ageCategories             String? // newline-separated (e.g. "U16", "U18", "U21")
  rankingRequirement        String?
  programTypes              String? // comma-separated: Full Package | Training Only | Race Support | Custom
  applicationUrl            String? // external apply URL — used instead of the internal /academy/[slug]/apply form when set
  featuredAcademy           Boolean  @default(false)
  contactEmail              String?
  publicApplyEnabled        Boolean  @default(true)

  programs     Program[]
  packages     Package[]
  applications Application[]
  opportunities Opportunity[]
  groups        Group[]
  coaches       Coach[]
  enrollments   Enrollment[]
  payments      Payment[]
  documents     Document[]
  invoices      Invoice[]
  notifications Notification[]
  expenses      Expense[]
  revenues      Revenue[]
  conversations Conversation[]
  users         User[]
  trainingSessions TrainingSession[]
  contracts     Contract[]
  calendarEvents CalendarEvent[]
  coachNotes    CoachNote[]
  tennisMatches TennisMatch[]
  budgetBenchmarks AcademyBudgetBenchmarks?
  createdAt     DateTime       @default(now())
}

// Per-academy cost benchmarks the budget forecast engine multiplies by
// quantities derived from the roster / season calendar / coach roster.
// Set ONCE per academy (admin form); the engine reads them on every
// `computeGroupBudgetForecast()` call and surfaces a per-group forecast
// alongside actual spend. Values are stored in currency major units
// (e.g. NOK 1000, not øre) and always interpreted in Academy.currency.
// Adding a sport-specific rate? Keep the field name generic so other
// sports (tennis camps, padel travel) can reuse it.
model AcademyBudgetBenchmarks {
  id        String  @id @default(cuid())
  academyId String  @unique
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)

  // ── Lodging / travel rates ──
  pricePerNight              Int @default(0)  // hotel / lodge per athlete per night on the road
  liftPassPerDay             Int @default(0)  // per athlete per training/race day on snow
  mealsPerDay                Int @default(0)  // per athlete per day while travelling
  fuelPerTravelDay           Int @default(0)  // per van / per travel day
  vanCostAnnual              Int @default(0)  // insurance + depreciation + service per academy / year
  housingMonthly             Int @default(0)  // long-stay apartment per athlete / month (base camp)
  housingMonthsPerSeason     Int @default(8)  // how many months the base-camp apartment runs
  clothingPerAthlete         Int @default(0)  // team kit / season / athlete

  // ── Staff rates ──
  headCoachMonthlyRate       Int @default(0)
  headCoachMonthsPerSeason   Int @default(12)
  assistantCoachMonthlyRate  Int @default(0)
  assistantCoachMonthsPerSeason Int @default(8)

  // ── Academy-wide overheads (allocated per group by share-of-athletes) ──
  miscAnnual                 Int @default(0)  // catch-all (admin, comms, etc.)
  sportOpsAnnual             Int @default(0)  // race entries, federation fees, equipment, …

  // ── Calendar fallbacks ──
  // Used when the season calendar (CalendarEvent) is empty so the page
  // still produces a sensible forecast on day 1. Once the calendar is
  // populated the engine prefers the real event totals.
  defaultTravelDaysPerSeason Int @default(0)
  defaultRaceDaysPerSeason   Int @default(0)
  defaultNightsPerSeason     Int @default(0)

  updatedAt DateTime @updatedAt
}

// Academy-wide calendar (summer / autumn / winter / spring programmes).
// Academy admin can manage any event; coaches manage events for their own groups;
// athletes see events for the groups they are enrolled in (+ academy-wide).
model CalendarEvent {
  id          String    @id @default(cuid())
  academyId   String
  academy     Academy   @relation(fields: [academyId], references: [id])
  groupId     String?   // null = academy-wide event
  group       Group?    @relation(fields: [groupId], references: [id])
  coachId     String?
  coach       Coach?    @relation(fields: [coachId], references: [id])
  title       String
  type        String    @default("training") // training | camp | race | travel | meeting | off | other
  season      String    @default("all") // summer | autumn | winter | spring | all
  startDate   DateTime
  endDate     DateTime?
  location    String?       // Plan A — primary location (e.g. "Saas-Fee", "Hintertux")
  planBLocation String?     // Plan B — alternative location
  discipline  String?       // SL | GS | SG | DH | Speed block | …
  notes       String?
  coachesNote String?       // free text for assigned coaches (Excel "Trenere" column)
  currency    String    @default("EUR")
  // Cost breakdown — coach inputs these; estimatedCost / actualCost are headline totals.
  costHotel       Int @default(0)
  costFlights     Int @default(0)
  costVan         Int @default(0)
  costFuel        Int @default(0)
  costLiftPass    Int @default(0)
  costCoach       Int @default(0)
  costAccommodation Int @default(0)
  costRaceFees    Int @default(0)
  costMisc        Int @default(0)
  estimatedCost   Int?      // override; else sum of breakdown
  actualCost      Int?      // what was actually spent
  createdById String?
  createdBy   User?     @relation("CalendarCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([academyId, startDate])
}

// A training session for a group on a date. Attendance is recorded per athlete.
model TrainingSession {
  id         String       @id @default(cuid())
  academyId  String
  academy    Academy      @relation(fields: [academyId], references: [id])
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id])
  date       DateTime
  title      String?
  coachId    String?
  coach      Coach?       @relation(fields: [coachId], references: [id])
  notes      String?
  attendance Attendance[]
  createdAt  DateTime     @default(now())
}

// Athlete contract tied to an enrollment. Status flows draft → sent → signed,
// with optional term dates + value (feeds contract reminders + finance later).
model Contract {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  status       String     @default("draft") // draft | sent | signed | expired
  startDate    DateTime?
  endDate      DateTime?
  value        Int? // contract value (currency major units)
  currency     String     @default("EUR")
  fileUrl      String?
  notes        String?
  signedAt     DateTime?
  createdAt    DateTime   @default(now())
}

model Attendance {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       String          @default("present") // present | late | absent | excused | injured
  note         String?
  createdAt    DateTime        @default(now())

  @@unique([sessionId, enrollmentId])
}

// Inbound academy onboarding requests (apply / request a demo). Reviewed in the
// super-admin portal; approval provisions a tenant + owner account.
model AcademyRequest {
  id          String   @id @default(cuid())
  academyName String
  contactName String
  email       String
  phone       String?
  country     String
  location    String?
  sport       String   @default("ski")
  plan        String   @default("BASIC") // requested tier
  message     String?
  status      String   @default("pending") // pending | approved | rejected
  reviewerNote String?
  provisionedAcademyId String? // set when approved → created Academy id
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  passwordHash String? // bcrypt hash; null = no credential set yet (legacy/demo)
  role      String   @default("coach") // super_admin | academy_admin | coach | athlete | recruiter
  academyId String? // null for super_admin (platform-level, not bound to a tenant)
  academy   Academy? @relation(fields: [academyId], references: [id])
  coachId   String? // links a coach login to their Coach record (scopes their workspace)
  coach     Coach?   @relation(fields: [coachId], references: [id])
  athleteId String? // links an athlete login to their Athlete record (My Profile workspace)
  athlete   Athlete? @relation(fields: [athleteId], references: [id])
  notes     Note[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  approvedExpenses Expense[] @relation("ExpenseApprover")
  expenseEvents ExpenseEvent[]
  createdCalendarEvents CalendarEvent[] @relation("CalendarCreator")
  authoredCoachNotes CoachNote[] @relation("CoachNoteAuthor")
  createdAt DateTime @default(now())
}

model Coach {
  id             String       @id @default(cuid())
  academyId      String
  academy        Academy      @relation(fields: [academyId], references: [id])
  name           String
  email          String?
  phone          String?
  role           String       @default("coach") // head_coach | coach | physio | s_and_c
  specialization String? // slalom, speed, fitness…
  cost           Int? // season cost / salary (currency major units) — used for group margin
  notes          String?
  active         Boolean      @default(true)
  groups         Group[]
  enrollments    Enrollment[]
  users          User[]
  expenses       Expense[]
  sessions       TrainingSession[]
  calendarEvents CalendarEvent[]
  coachNotes     CoachNote[]
  // Living "coaching style" — themeFrequency + recurring focus areas
  // aggregated across every note this coach writes. The structurer feeds
  // this back into the LLM prompt so analyses become personalised over
  // time (Coach A → technical-heavy, Coach B → tactical-heavy, …).
  aiStyle        Json?
  aiStyleUpdatedAt DateTime?
  createdAt      DateTime     @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  coachId     String? // null = entered directly by the academy admin (a group budget line)
  coach       Coach?   @relation(fields: [coachId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  title       String
  amount      Int
  currency    String   @default("EUR")
  category    String   @default("other") // hotel | fuel | lift_pass | transport | equipment | race_cost | other (legacy: travel | accommodation)
  status      String   @default("draft") // draft | submitted (pending) | approved | rejected | reimbursed
  notes       String?
  expenseDate DateTime? // when the cost was incurred (defaults to createdAt if unset)
  receiptUrl  String? // link to the uploaded receipt
  approvedById String? // user (academy admin) who approved/rejected
  approvedBy   User?    @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  events      ExpenseEvent[]
  createdAt   DateTime @default(now())
}

// Income — non-Payment revenue streams that feed a team's budget.
// Athlete fees flow through Payment (per-enrollment). Everything else — sponsor
// deals, federation grants, academy allocations — lives here so the Budget
// Tracker can show a real net result (income − expense) per team.
// Manual entry today; future integrations (Stripe, bank import) drop in here.
model Revenue {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  title       String
  amount      Int      // currency major units (e.g. EUR)
  currency    String   @default("EUR")
  // athlete_fee  = aggregated/individual fee outside the Payment flow
  // sponsor      = sponsor contribution
  // federation   = federation grant / contribution
  // academy_allocation = budget allocated from the academy's general pot
  // other        = misc
  category    String   @default("other")
  // received   = cash in the bank already
  // pledged    = promised, not yet received (counts as forecast)
  // cancelled  = killed
  status      String   @default("received")
  receivedDate DateTime?
  notes       String?
  source      String?  // free text: sponsor name, federation name, etc.
  createdAt   DateTime @default(now())

  @@index([academyId, groupId])
}

// Immutable audit trail for an expense — every status change / edit, with who + when.
model ExpenseEvent {
  id         String   @id @default(cuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  type       String // created | submitted | approved | rejected | reimbursed | edited
  fromStatus String?
  toStatus   String?
  byUserId   String?
  byUser     User?    @relation(fields: [byUserId], references: [id])
  byName     String? // denormalised actor name (survives user deletion)
  note       String?
  createdAt  DateTime @default(now())
}

model Program {
  id           String        @id @default(cuid())
  academyId    String
  academy      Academy       @relation(fields: [academyId], references: [id])
  name         String
  discipline   String
  ageMin       Int
  ageMax       Int
  season       String
  applications Application[]
}

model Package {
  id            String        @id @default(cuid())
  academyId     String
  academy       Academy       @relation(fields: [academyId], references: [id])
  name          String
  description   String?
  price         Int? // in currency major units
  currency      String        @default("EUR")
  period        String        @default("season") // season | camp | month
  billingFreq   String        @default("seasonal") // one_time | monthly | seasonal
  features      String? // newline-separated
  accommodation Boolean       @default(false)
  transport     Boolean       @default(false)
  coaching      Boolean       @default(true)
  raceSupport   Boolean       @default(false)
  maxAthletes   Int?
  active        Boolean       @default(true)
  notes         String?
  order         Int           @default(0)
  applications  Application[]
  enrollments   Enrollment[]
}

model Athlete {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  dob             DateTime
  nationality     String
  gender          String?
  sport           String         @default("ski")
  discipline      String
  email           String?
  phone           String?
  address         String?
  emergencyContact String?
  guardianName    String?
  guardianContact String?
  fisCode         String?        @unique
  fisPoints       Float?
  worldRank       Int?
  injuryFlag      Boolean        @default(false)
  photoColor      String         @default("#1f2937")
  bio             String?
  location        String?
  verified        Boolean        @default(true)

  // ── Public recruiting profile (read by the profiles.leaf.ai experience) ──
  // All public visibility is opt-in and per-field. The public read layer
  // (src/lib/profiles.ts) is the ONLY place these are exposed, and it never
  // returns the private columns above (notes, injuryFlag, contacts, etc.).
  publicProfileEnabled      Boolean  @default(false)
  publicSlug                String?  @unique
  publicVisibility          String   @default("PRIVATE") // PUBLIC | PRIVATE | INVITE_ONLY | ACADEMY_ONLY
  publicBio                 String?
  publicPhotoUrl            String?
  publicShowAcademy         Boolean  @default(true)
  publicShowRanking         Boolean  @default(true)
  publicShowResults         Boolean  @default(true)
  publicShowMedia           Boolean  @default(true)
  publicShowExternalProfiles Boolean @default(true)
  publicContactEnabled      Boolean  @default(false)
  publicVerified            Boolean  @default(false)
  fisProfileUrl             String?
  atpPlayerId               String?
  atpProfileUrl             String?

  rankings        RankingPoint[]
  fisSnapshots    FisListSnapshot[]
  results         Result[]
  media           Media[]
  publicMedia     PublicAthleteMedia[]
  applications    Application[]
  enrollments     Enrollment[]
  conversations   Conversation[]
  users           User[]
  coachNotes      CoachNote[]

  // Living athlete profile maintained by the Coach Intelligence engine.
  // Shape is intentionally Json — the structurer evolves per sport, so the
  // schema must not lock the dimensions in concrete. See lib/ai/coachProfile.ts
  // for the canonical AthleteAiProfile type.
  aiProfile       Json?
  aiProfileUpdatedAt DateTime?

  // ── Tennis (and other coach-driven sports) profile fields ──
  // Ski uses FIS code / points / world rank (above). Tennis is development-
  // based, so it carries coach-curated dimensions instead. All optional and
  // sport-agnostic at the column level — the UI shows them only when
  // athlete.sport === "tennis" (or whichever sports we add later).
  dominantHand    String?        // right | left | ambidextrous
  playingStyle    String?        // free text: "aggressive baseliner", "all-court", …
  // 1..10 self/coach-rated levels — feed the future tennis dashboards.
  technicalLevel  Int?
  tacticalLevel   Int?
  physicalLevel   Int?
  mentalLevel     Int?
  developmentGoals String?       // free text, multiline

  // Season-level intent set by the athlete (or coach) — surfaced on /me
  // and on the admin detail page. Free text, multiline. Drives no logic
  // today; AI Coach Notes may align suggestions against it in the future.
  seasonGoals     String?

  tennisMatches   TennisMatch[]

  // Universal Athlete Performance Layer — 1:1 sport-specific extension
  // tables. New writes target these; old reads still hit the legacy columns
  // above as fallback (see lib/athleteProfile.ts).
  skiProfile      SkiProfile?
  tennisProfileExt TennisProfile?

  createdAt       DateTime       @default(now())
}

// Curated public portfolio assets, separate from internal `Media`. Only rows with
// isApprovedPublic = true are ever surfaced on the public profile.
model PublicAthleteMedia {
  id            String   @id @default(cuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  type          String // IMAGE | VIDEO | PDF | LINK
  title         String
  url           String
  thumbnailUrl  String?
  isApprovedPublic Boolean @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Historical FIS points snapshots — the source of the growth trend.
model RankingPoint {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime
  fisPoints Float
  worldRank Int?
}

// Per-discipline FIS points snapshot, captured from a specific official FIS
// points list (fis-ski.com publishes ~22 lists per season). Each (athlete,
// list, discipline) tuple is unique. Stored once per sync — the live FIS
// provider walks the most recent N lists and upserts the rows it finds.
//
// Powers the per-discipline trend on the athlete page (lib/ai/pointsTrend.ts)
// without ever fabricating data: a discipline with one snapshot reads as
// "insufficient_data", two or more drive an improving/declining trend.
model FisListSnapshot {
  id          String   @id @default(cuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  listid      Int      // FIS source list id (e.g. 452 → "22nd FIS points list 2025/26")
  publishedAt DateTime // list valid-from date — what the trend chart plots against
  discipline  String   // slalom | giant_slalom | super_g | downhill
  fisPoints   Float
  worldRank   Int?
  syncedAt    DateTime @default(now())

  @@unique([athleteId, listid, discipline])
  @@index([athleteId, discipline, publishedAt])
}

model Result {
  id         String   @id @default(cuid())
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  date       DateTime
  eventName  String
  location   String
  discipline String
  rank       Int // finishing place (ignored when status != finished)
  fisPoints  Float
  status     String   @default("finished") // finished | dnf | dns | dsq — powers DNF% analytics
}

model Media {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])
  type      String
  title     String
  duration  String?
}

model Application {
  id             String        @id @default(cuid())
  academyId      String
  academy        Academy       @relation(fields: [academyId], references: [id])
  athleteId      String
  athlete        Athlete       @relation(fields: [athleteId], references: [id])
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id])
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id])
  status         String        @default("new") // new | reviewing | shortlisted | accepted | rejected
  score          Int?
  source         String        @default("public_form")
  message        String?
  sport          String?
  currentRanking String?
  previousClub   String?
  guardianName   String?
  guardianContact String?
  mediaLink      String?
  customFields   Json? // academy-defined custom question answers ({ [fieldKey]: value })
  suggestedGroupId String? // auto-placement computed on arrival (Smart Group Assignment); overridable
  submittedAt    DateTime      @default(now())
  notes          Note[]
  events         StatusEvent[]
  enrollment     Enrollment?
  conversation   Conversation?
}

// A publishable recruiting opening (program / team position / camp / package).
// The dashboard creates these; the public academy site lists the published ones;
// applications can reference the opportunity they came from.
model Opportunity {
  id                  String        @id @default(cuid())
  academyId           String
  academy             Academy       @relation(fields: [academyId], references: [id])
  title               String
  type                String        @default("program") // program | position | camp | package
  season              String?
  ageGroup            String? // e.g. "U16-U18"
  discipline          String? // SL | GS | SG | DH | XC | ...
  packageType         String? // free-text package/tier label
  price               Int? // currency major units
  currency            String        @default("EUR")
  pricePublic         Boolean       @default(false) // show price publicly?
  applicationDeadline DateTime?
  spotsAvailable      Int?
  description         String?
  status              String        @default("draft") // draft | published | closed
  applications        Application[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// Active Athlete = an athlete enrolled at an academy. Multi-tenant by academyId.
model Enrollment {
  id            String            @id @default(cuid())
  academyId     String
  academy       Academy           @relation(fields: [academyId], references: [id])
  athleteId     String
  athlete       Athlete           @relation(fields: [athleteId], references: [id])
  status        String            @default("active") // active | paused | injured | completed | inactive
  level         String? // development | competitive | elite
  joinDate      DateTime          @default(now())
  coachId       String?
  coach         Coach?            @relation(fields: [coachId], references: [id])
  groupId       String?
  group         Group?            @relation(fields: [groupId], references: [id])
  packageId     String?
  package       Package?          @relation(fields: [packageId], references: [id])
  applicationId String?           @unique
  application   Application?      @relation(fields: [applicationId], references: [id])
  externalCustomerId String?      // maps this enrollment to a customer in the academy's finance system
  notes         String?
  payments      Payment[]
  documents     Document[]
  invoices      Invoice[]
  events        EnrollmentEvent[]
  conversations Conversation[]
  attendance    Attendance[]
  contracts     Contract[]
  createdAt     DateTime          @default(now())
}

model EnrollmentEvent {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  type         String // status | created | payment | document
  from         String?
  to           String?
  detail       String?
  createdAt    DateTime   @default(now())
}

model Payment {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  label        String? // e.g. "Installment 1/3"
  amount       Int
  paidAmount   Int        @default(0) // amount collected so far (for partial payments)
  currency     String     @default("EUR")
  dueDate      DateTime
  paidDate     DateTime?
  status       String     @default("unpaid") // unpaid | paid | partial  (overdue is derived from dueDate)
  method       String? // bank_transfer | card | cash
  notes        String?
  source       String     @default("leaf") // leaf | external  (external = synced from a finance provider, read-only)
  externalId   String? // id of the source record in the external finance system
  invoice      Invoice?
  createdAt    DateTime   @default(now())

  @@index([academyId, externalId])
}

model Document {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  type         String // medical_certificate | liability_waiver | academy_contract | race_license | travel | parent_approval | internal
  name         String?
  status       String     @default("missing") // missing | uploaded | verified | expired
  fileUrl      String?
  required     Boolean    @default(true)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  authorId      String?
  author        User?       @relation(fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
}

model StatusEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  from          String?
  to            String
  createdAt     DateTime    @default(now())
}

model Group {
  id          String       @id @default(cuid())
  academyId   String
  academy     Academy      @relation(fields: [academyId], references: [id])
  name        String
  sport       String       @default("ski")
  season      String
  coachId     String?
  coach       Coach?       @relation(fields: [coachId], references: [id])
  capacity    Int          @default(12)
  budget      Int? // allocated season budget (currency major units)
  budgetHardStop Boolean   @default(false) // block approvals that would exceed the budget
  active      Boolean      @default(true)
  notes       String?
  // ── Smart Group Assignment rules (per-academy config) ──
  // Null = no constraint. Points band is in the sport's native scale (e.g. FIS
  // points). The recommender scores applicants against these bands.
  pointsMin   Int? // lower bound of the group's ranking-points band
  pointsMax   Int? // upper bound
  ageMin      Int?
  ageMax      Int?
  level       String? // development | competitive | elite (target level)
  discipline  String? // optional discipline filter (null = any)
  enrollments   Enrollment[]
  expenses      Expense[]
  revenues      Revenue[]
  conversations Conversation[]
  sessions      TrainingSession[]
  calendarEvents CalendarEvent[]
  createdAt     DateTime     @default(now())
}

model Invoice {
  id           String     @id @default(cuid())
  academyId    String
  academy      Academy    @relation(fields: [academyId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  paymentId    String?    @unique
  payment      Payment?   @relation(fields: [paymentId], references: [id])
  number       String
  amount       Int
  currency     String     @default("EUR")
  status       String     @default("pending") // pending | sent | partial | paid | cancelled  (overdue derived from due date)
  issuedAt     DateTime   @default(now())
  dueDate      DateTime? // due date (external invoices carry their own; LEAF ones derive it from the payment)
  paidAt       DateTime?
  source       String     @default("leaf") // leaf | external
  externalId   String? // id of the source record in the external finance system

  @@index([academyId, externalId])
}

model Notification {
  id            String   @id @default(cuid())
  academyId     String
  academy       Academy  @relation(fields: [academyId], references: [id])
  type          String // thanks_for_applying | application_accepted | application_rejected | missing_documents | payment_reminder | payment_confirmation | invoice_available | enrollment_confirmed
  toEmail       String?
  toName        String?
  subject       String
  body          String
  status        String   @default("sent") // queued | sent
  applicationId String?
  enrollmentId  String?
  createdAt     DateTime @default(now())
}

// Internal communication layer. A thread is created with the application and follows
// the athlete through enrollment (history preserved).
model Conversation {
  id                   String       @id @default(cuid())
  academyId            String
  academy              Academy      @relation(fields: [academyId], references: [id])
  type                 String       @default("application") // application | athlete | group
  applicationId        String?      @unique
  application          Application? @relation(fields: [applicationId], references: [id])
  enrollmentId         String?
  enrollment           Enrollment?  @relation(fields: [enrollmentId], references: [id])
  athleteId            String?
  athlete              Athlete?     @relation(fields: [athleteId], references: [id])
  groupId              String?
  group                Group?       @relation(fields: [groupId], references: [id])
  subject              String?
  status               String       @default("open") // open | waiting | resolved
  assignedToUserId     String?
  assignedTo           User?        @relation("AssignedConversations", fields: [assignedToUserId], references: [id])
  lastMessageAt        DateTime     @default(now())
  lastMessagePreview   String?
  lastReadByStaffAt    DateTime?
  lastReadByExternalAt DateTime?
  // AI-ready (not used yet): summary, sentiment, risk flag
  summary              String?
  sentiment            String?
  riskFlag             Boolean      @default(false)
  messages             Message[]
  createdAt            DateTime     @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderSide     String // external | staff | system
  senderRole     String? // applicant | parent | athlete | coach | admin | system
  senderName     String?
  senderUserId   String?
  body           String
  createdAt      DateTime     @default(now())
}

// ── Coach Intelligence — Adaptive Coach Notes ─────────────────────────────
// The coach writes naturally (free text + optional file refs); the AI engine
// in lib/ai/coachNotes.ts reads it, detects the sport context (from the
// athlete's group), structures it dynamically, and merges insights into the
// athlete's living aiProfile. Raw text is preserved so the coach can always
// re-read what they actually wrote.
model CoachNote {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id])
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id])
  // Coach attribution — coachId for the academy-side coach record; authorId
  // ties back to the User who wrote it (admin can author notes too).
  coachId     String?
  coach       Coach?   @relation(fields: [coachId], references: [id])
  authorId    String?
  author      User?    @relation("CoachNoteAuthor", fields: [authorId], references: [id])

  // Original observation in the coach's own words. Never re-written by the AI.
  rawText     String
  // Sport snapshot at write time (taken from the athlete's group). Drives the
  // AI's analytic lens (ski technical/race; tennis match intelligence; ...).
  sport       String   @default("ski")
  // Optional coach-supplied kind hint. The structurer may refine / override.
  kind        String?  // training_session | race | match | video_review | physical_block | testing | other

  // Structured output of the AI — Json so dimensions can evolve per sport
  // without schema churn. Canonical shape in lib/ai/coachNotes.ts.
  aiSummary   Json?
  // Lifecycle of the structuring pass.
  status      String   @default("pending") // pending | structured | failed
  // Which engine produced aiSummary (llm | deterministic). Set by the worker.
  engine      String?
  error       String?

  attachments CoachNoteAttachment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([academyId, athleteId, createdAt])
}

// Tennis (and other coach-driven sports) match record. Lightweight — opponent
// + date + result + score string + optional notes. Drives W/L stats on the
// athlete page; no ATP/WTA dependency by design.
model TennisMatch {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id])
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  date      DateTime
  opponent  String
  result    String   // won | lost
  score     String?  // e.g. "6-3 4-6 7-5"
  surface   String?  // hard | clay | grass | indoor
  notes     String?
  createdAt DateTime @default(now())

  @@index([academyId, athleteId, date])
}

// ── Universal Athlete Performance Layer ───────────────────────────────────
// Athlete stays the universal record (name, sport, contacts, …). Each sport
// owns a 1:1 profile table that holds its dimensions. This is the future-proof
// shape — for the MVP the legacy columns on Athlete (fisCode/fisPoints, the
// tennis levels) still drive the UI. The accessor lib/athleteProfile.ts
// reads either source (new table wins, falls back to the legacy columns),
// so call sites can migrate one at a time without breaking anything.
model SkiProfile {
  id         String   @id @default(cuid())
  athleteId  String   @unique
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  fisCode    String?  @unique
  fisPoints  Float?
  worldRank  Int?
  // Primary specialty (SL / GS / SG / DH / …). Athlete.discipline kept as
  // the legacy mirror; this one wins when populated.
  specialty  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TennisProfile {
  id               String   @id @default(cuid())
  athleteId        String   @unique
  athlete          Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  dominantHand     String?
  playingStyle     String?
  technicalLevel   Int?
  tacticalLevel    Int?
  physicalLevel    Int?
  mentalLevel      Int?
  developmentGoals String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Files attached to a note — PDF, Excel, scouting reports, etc. For the MVP
// we record metadata + a URL (paste-link or future Supabase Storage upload);
// no binary blob is held in Postgres.
model CoachNoteAttachment {
  id        String    @id @default(cuid())
  noteId    String
  note      CoachNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String    @default("application/octet-stream")
  size      Int       @default(0) // bytes; 0 = unknown (paste-link case)
  url       String
  createdAt DateTime  @default(now())
}
