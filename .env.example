# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and paste ONE value: your Supabase connection string.
#
#   cp .env.example .env
#
# Where to get it:
#   Supabase  →  your project  →  "Connect" (top bar)  →  "Session pooler"  →  copy the URI.
#
# It must look like the example below:
#   • username starts with  postgres.<your-project-ref>   (NOT just "postgres")
#   • host ends with         .pooler.supabase.com
#   • port is                5432
#   • replace [YOUR-PASSWORD] with your database password
#
# Do NOT add ?sslmode=... — the app sets TLS automatically.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
