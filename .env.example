# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env":   cp .env.example .env
#
# DATABASE_URL = the app's database connection. On Vercel (serverless) you MUST use
# Supabase's TRANSACTION pooler (port 6543) — the Session pooler (5432) runs out of
# connections under serverless ("max clients reached in session mode").
#
# Get it:  Supabase → your project → "Connect" → "Transaction pooler" → copy the URI.
#   • username starts with  postgres.<your-project-ref>   (NOT just "postgres")
#   • host ends with         .pooler.supabase.com
#   • port is                6543   (it includes ?pgbouncer=true)
#   • replace [YOUR-PASSWORD] with your database password
#   • do NOT add ?sslmode=...  — the app sets TLS automatically
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = Supabase "Session pooler" (port 5432). Used by `prisma db push` (migrations
# + the build's schema sync). REQUIRED on Vercel — the build runs `prisma db push`, which
# hangs on the 6543 transaction pooler, so it must use this 5432 session pooler instead.
# Locally it's optional (falls back to DATABASE_URL).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Auth, email & data source (all optional — sensible fallbacks for local/demo)
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_SECRET = HMAC key that signs session cookies. Set a long random value in
# production (e.g. `openssl rand -base64 32`). Falls back to a dev key if unset.
AUTH_SECRET=""

# ALLOW_DEMO_LOGIN = "1" keeps the one-click demo user buttons working in
# production. Leave unset to require email + password there.
ALLOW_DEMO_LOGIN=""

# DEMO_PASSWORD = password applied to seeded/backfilled demo accounts (default leaf2026).
DEMO_PASSWORD=""

# RESEND_API_KEY = enables real email delivery via Resend. When unset, notifications
# are still recorded (status "queued") but no email is sent.
RESEND_API_KEY=""
EMAIL_FROM="LEAF <onboarding@resend.dev>"

# FIS_PROVIDER = live | simulated | auto (default auto: real FIS data with a
# simulated fallback so demo codes and offline still work).
FIS_PROVIDER=""
